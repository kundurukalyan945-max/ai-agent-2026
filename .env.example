# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit it.

# Required: get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# Optional: override the default model (default: llama-3.3-70b-versatile)
# See available models: https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional: store Career Agent SQLite data on a durable mounted volume.
# On hosted deployments, do not rely on the app filesystem surviving restarts.
# CAREER_DB_PATH=/persistent/storage/career_agent.sqlite3

# Optional: hosted PostgreSQL (Supabase recommended for persistent deployment).
# Copy the URL from Supabase Dashboard -> Connect. Prefer Session pooler for IPv4-only hosts.
# Keep the real password in Streamlit Secrets / deployment secrets, not in Git.
# CAREER_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres

# Optional: Happenstance API key. A network search costs 2 credits.
# Store the actual key in Streamlit Secrets / deployment secrets, never in Git.
# HAPPENSTANCE_API_KEY=your_happenstance_api_key
